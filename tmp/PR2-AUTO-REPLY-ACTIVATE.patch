+// ─────────────────────────────────────────────────────────────────────────────
+// containsOptOutKeyword — VETO sans borne de longueur (PR2, MAJEUR-4)
+// ─────────────────────────────────────────────────────────────────────────────
+
+describe("containsOptOutKeyword — veto anti-avalement d'opt-out", () => {
+  it("🔒 détecte un opt-out DANS un message long, là où isOptOut abandonne", () => {
+    // Le cas exact que ce prédicat existe pour couvrir : un message à la
+    // fois MACHINE et OPT-OUT. `isOptOut` le rate (> 50 chars), le
+    // classifier le range en AUTO_REPLY (2 signaux structurels francs), et
+    // sans ce veto la coupure PR2 avalerait la demande d'arrêt.
+    const machineEtOptOut =
+      "Message automatique du secrétariat : merci de ne plus adresser de sollicitations commerciales à ce cabinet. ARRET des envois demandé. Fermé le vendredi.";
