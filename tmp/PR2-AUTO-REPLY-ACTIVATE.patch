+    expect(machineEtOptOut.length).toBeGreaterThan(OPT_OUT_MAX_INCOMING_LENGTH);
+    expect(isOptOut(machineEtOptOut)).toBe(false); // la borne 50 chars abandonne
+    expect(containsOptOutKeyword(machineEtOptOut)).toBe(true); // le veto attrape
+  });
+
+  it("couvre les 5 mots-clés, sans borne de longueur", () => {
+    const padding = "x".repeat(OPT_OUT_MAX_INCOMING_LENGTH + 20);
+    for (const kw of OPT_OUT_KEYWORDS) {
+      expect(containsOptOutKeyword(`${padding} ${kw} ${padding}`)).toBe(true);
+    }
+  });
+
+  it("même normalisation anti-évasion que isOptOut (accents + invisibles)", () => {
+    expect(containsOptOutKeyword("Merci de bien vouloir arrêter vos envois, cordialement.")).toBe(
+      true,
+    );
+    // ZWSP inséré au milieu du mot-clé (attaque S4 M1).
+    expect(containsOptOutKeyword(`${"x".repeat(60)} S​TOP`)).toBe(true);
+  });
+
+  it("message sans mot-clé → false (le veto ne bloque pas tout)", () => {
+    expect(
+      containsOptOutKeyword(
+        "Réponse automatique : je suis absent du 12 au 26 août et ne consulte pas mes messages.",
+      ),
+    ).toBe(false);
+  });
+
+  it("message vide → false", () => {
+    expect(containsOptOutKeyword("")).toBe(false);
+    expect(containsOptOutKeyword("   ")).toBe(false);
+  });
+
+  it("⚠️ NE PAS confondre avec isOptOut : ce prédicat sur-détecte par design", () => {
+    // Une phrase de conversation contenant « stop » par hasard déclenche
+    // le veto — c'est VOULU (on refuse seulement de couper), et c'est
+    // exactement pourquoi il ne doit JAMAIS servir à décider un opt-out.
+    const conversation =
+      "J'ai vu votre message, je suis en plein stop-and-go entre deux consultations, rappelez-moi jeudi.";
+    expect(isOptOut(conversation)).toBe(false);
+    expect(containsOptOutKeyword(conversation)).toBe(true);
+  });
+});
diff --git a/src/lib/compliance/opt-out.ts b/src/lib/compliance/opt-out.ts
index cfc86d4..c4ed447 100644
--- a/src/lib/compliance/opt-out.ts
+++ b/src/lib/compliance/opt-out.ts
@@ -141,3 +141,49 @@ export function isOptOut(incomingMessage: string): boolean {
   if (normalized.length > OPT_OUT_MAX_INCOMING_LENGTH) return false;
   return OPT_OUT_KEYWORDS.some((kw) => normalized.includes(kw));
 }
+
+/**
+ * Vrai si le message entrant contient un mot-clé d'opt-out, **SANS la
+ * borne des 50 caractères** de `isOptOut`.
+ *
+ * ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
+ * 🚨 CE N'EST PAS UN DÉTECTEUR D'OPT-OUT — C'EST UN VETO
+ *
+ * N'utilise JAMAIS cette fonction pour DÉCIDER un opt-out : sans la borne
+ * de longueur, une phrase de conversation contenant « stop » par hasard
+ * la déclencherait, et on désabonnerait un PS qui ne l'a pas demandé.
+ * C'est exactement le faux positif que la borne des 50 chars existe pour
+ * éviter (cf. `isOptOut`). La décision d'opt-out reste : `isOptOut`
+ * (court) puis le classifier Claude (long-form, GUARD-001).
+ *
+ * Son usage légitime est INVERSE : empêcher une autre règle de couper le
+ * traitement d'un message qui pourrait être une demande d'arrêt.
+ *
+ * ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
+ * CAS D'USAGE (PR2-AUTO-REPLY-ACTIVATE, MAJEUR-4)
+ *
+ * Le classifier ne rend qu'UN seul label. Un message long à la fois
+ * MACHINE et OPT-OUT — typiquement « Message automatique du secrétariat :
+ * merci de ne plus adresser de sollicitations à ce cabinet. Fermé le
+ * vendredi. » — porte deux signaux structurels d'`AUTO_REPLY` francs et
+ * se verrait classé machine. La coupure PR2 l'avalerait : ni réponse, ni
+ * `markOptedOut`, contact toujours démarchable. **L.34-5 CPCE caractérisé.**
+ *
+ * `process-reply` conditionne donc la coupure `AUTO_REPLY` à l'absence de
+ * tout mot-clé d'opt-out dans le body brut. Un message machine qui
+ * contient « ne plus », « arrêt », « désinscription » retombe sur le
+ * traitement normal et reste examinable.
+ *
+ * Asymétrie des coûts, qui justifie l'absence de borne de longueur :
+ *   - faux positif ici (on ne coupe pas une vraie machine) → on répond à
+ *     une machine, borné par le plafond de volume. Bénin.
+ *   - faux négatif (on avale un opt-out) → infraction. Inacceptable.
+ *
+ * Même normalisation que `isOptOut` (NFKD + strip diacritiques/invisibles
+ * + uppercase) : la logique anti-évasion vit en un seul endroit.
+ */
+export function containsOptOutKeyword(incomingMessage: string): boolean {
+  const normalized = normalizeIncoming(incomingMessage);
+  if (normalized.length === 0) return false;
+  return OPT_OUT_KEYWORDS.some((kw) => normalized.includes(kw));
+}
